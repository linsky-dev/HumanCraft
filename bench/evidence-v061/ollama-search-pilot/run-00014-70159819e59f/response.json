  "response": "```html\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Search Flow</title>\n<style>\n  body {\n    font: 16px system-ui;\n    color: #142c26;\n    background: #f7faf8;\n    margin: 0;\n  }\n  main {\n    max-width: 680px;\n    padding: 24px;\n    margin: auto;\n  }\n  label, output {\n    display: block;\n    margin: 8px 0;\n  }\n  button, input, select, textarea {\n    font: inherit;\n    padding: 8px;\n    margin: 4px 4px 4px 0;\n    max-width: 100%;\n    box-sizing: border-box;\n  }\n  button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible {\n    outline: 3px solid #126e55;\n    outline-offset: 2px;\n  }\n  button {\n    background: #e6f0eb;\n    border: 1px solid #456c5c;\n    border-radius: 5px;\n  }\n  button:disabled {\n    opacity: .5;\n  }\n  [role=\"dialog\"] {\n    border: 1px solid #456c5c;\n    padding: 16px;\n  }\n</style>\n</head>\n<body>\n<main>\n  <h1>Search records</h1>\n  <label for=\"q\">Search query</label>\n  <input id=\"q\" type=\"text\" placeholder=\"Enter a search term\">\n  <button id=\"go\">Search</button>\n  <output id=\"status\" role=\"status\"></output>\n  <p id=\"result\"></p>\n</main>\n<script>\n  const field = document.getElementById(\"q\");\n  const go = document.getElementById(\"go\");\n  const out = document.getElementById(\"status\");\n  const result = document.getElementById(\"result\");\n\n  // State interface: { query, result }\n  let state = { query: \"\", result: \"\" };\n\n  // Debounce helper to ensure slow searches don't overwrite fast ones\n  let debounceTimer = null;\n\n  go.onclick = () => {\n    const q = field.value;\n    if (!q) {\n      state.query = \"\";\n      state.result = \"\";\n      out.textContent = \"Please enter a query.\";\n      result.textContent = \"\";\n      return;\n    }\n\n    // Always update the latest query immediately\n    state.query = q;\n    out.textContent = \"Searching \" + q;\n    result.textContent = \"\";\n\n    // Determine delay based on query content (simulating slow vs fast search)\n    const isSlow = q === \"alpha\";\n    const delay = isSlow ? 180 : 30;\n\n    // Clear any pending slow search to prevent overwriting the latest query\n    if (debounceTimer) {\n      clearTimeout(debounceTimer);\n      debounceTimer = null;\n    }\n\n    // Start the new search\n    debounceTimer = setTimeout(() => {\n      state.result = q;\n      out.textContent = \"Results for \" + q;\n      result.textContent = \"Found: \" + q;\n    }, delay);\n  };\n\n  // Allow Enter key to trigger search\n  field.addEventListener(\"keydown\", (e) => {\n    if (e.key === \"Enter\") {\n      go.click();\n    }\n  });\n\n  // Expose state for external access\n  window.readState = () => state;\n</script>\n</body>\n</html>\n```",
